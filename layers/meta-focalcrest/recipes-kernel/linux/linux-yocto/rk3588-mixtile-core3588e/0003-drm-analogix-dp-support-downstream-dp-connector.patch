From b0412c37798204656d3c1b51eae98d3b9628f024 Mon Sep 17 00:00:00 2001
From: Kevin Zhuang <kevin.zhuang@focalcrest.com>
Date: Fri, 23 Oct 2026 13:25:04 +0800
Subject: [PATCH] drm/analogix: support a downstream DP connector

Use the downstream bridge type to select the DP connector type and DP register-generated video timing; eDP panels keep the eDP connector and VOP capture timing.

Upstream-Status: Pending
---
 .../drm/bridge/analogix/analogix_dp_core.c    | 23 ++++++++++++++++---
 .../gpu/drm/rockchip/analogix_dp-rockchip.c   |  6 ++++-
 include/drm/bridge/analogix_dp.h              |  1 +
 3 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/bridge/analogix/analogix_dp_core.c b/drivers/gpu/drm/bridge/analogix/analogix_dp_core.c
index efe534977d12..9704af45ff85 100644
--- a/drivers/gpu/drm/bridge/analogix/analogix_dp_core.c
+++ b/drivers/gpu/drm/bridge/analogix/analogix_dp_core.c
@@ -719,8 +719,12 @@ static int analogix_dp_config_video(struct analogix_dp_device *dp)
 	/* Set to use the register calculated M/N video */
 	analogix_dp_set_video_cr_mn(dp, CALCULATED_M, 0, 0);
 
-	/* For video bist, Video timing must be generated by register */
-	analogix_dp_set_video_timing_mode(dp, VIDEO_TIMING_FROM_CAPTURE);
+	/* DP uses register timing; eDP panels capture the VOP timing */
+	if (dp->plat_data->bridge &&
+	    dp->plat_data->bridge->type == DRM_MODE_CONNECTOR_DisplayPort)
+		analogix_dp_set_video_timing_mode(dp, VIDEO_TIMING_FROM_REGISTER);
+	else
+		analogix_dp_set_video_timing_mode(dp, VIDEO_TIMING_FROM_CAPTURE);
 
 	/* Disable video mute */
 	analogix_dp_enable_video_mute(dp, 0);
@@ -1043,6 +1047,7 @@ static int analogix_dp_bridge_attach(struct drm_bridge *bridge,
 {
 	struct analogix_dp_device *dp = to_dp(bridge);
 	struct drm_connector *connector = NULL;
+	int connector_type = DRM_MODE_CONNECTOR_eDP;
 	int ret = 0;
 
 	if (flags & DRM_BRIDGE_ATTACH_NO_CONNECTOR) {
@@ -1050,13 +1055,25 @@ static int analogix_dp_bridge_attach(struct drm_bridge *bridge,
 		return -EINVAL;
 	}
 
+	if (dp->plat_data->bridge) {
+		ret = drm_bridge_attach(encoder, dp->plat_data->bridge, bridge,
+					DRM_BRIDGE_ATTACH_NO_CONNECTOR);
+		if (ret) {
+			DRM_ERROR("Failed to attach downstream bridge\n");
+			return ret;
+		}
+
+		if (dp->plat_data->bridge->type != DRM_MODE_CONNECTOR_Unknown)
+			connector_type = dp->plat_data->bridge->type;
+	}
+
 	if (!dp->plat_data->skip_connector) {
 		connector = &dp->connector;
 		connector->polled = DRM_CONNECTOR_POLL_HPD;
 
 		ret = drm_connector_init(dp->drm_dev, connector,
 					 &analogix_dp_connector_funcs,
-					 DRM_MODE_CONNECTOR_eDP);
+					 connector_type);
 		if (ret) {
 			DRM_ERROR("Failed to initialize connector with drm\n");
 			return ret;
diff --git a/drivers/gpu/drm/rockchip/analogix_dp-rockchip.c b/drivers/gpu/drm/rockchip/analogix_dp-rockchip.c
index d30f0983a53a..050cda49184e 100644
--- a/drivers/gpu/drm/rockchip/analogix_dp-rockchip.c
+++ b/drivers/gpu/drm/rockchip/analogix_dp-rockchip.c
@@ -437,6 +437,7 @@ static int rockchip_dp_link_panel(struct drm_dp_aux *aux)
 {
 	struct analogix_dp_plat_data *plat_data = analogix_dp_aux_to_plat_data(aux);
 	struct rockchip_dp_device *dp = pdata_encoder_to_dp(plat_data);
+	struct drm_bridge *bridge = NULL;
 	int ret;
 
 	/*
@@ -444,10 +445,13 @@ static int rockchip_dp_link_panel(struct drm_dp_aux *aux)
 	 * or bridge nodes. The driver should go on for the driver-free bridge or the DP
 	 * mode applications.
 	 */
-	ret = drm_of_find_panel_or_bridge(dp->dev->of_node, 1, 0, &plat_data->panel, NULL);
+	ret = drm_of_find_panel_or_bridge(dp->dev->of_node, 1, 0,
+					  &plat_data->panel, &bridge);
 	if (ret && ret != -ENODEV)
 		return ret;
 
+	plat_data->bridge = bridge;
+
 	return component_add(dp->dev, &rockchip_dp_component_ops);
 }
 
diff --git a/include/drm/bridge/analogix_dp.h b/include/drm/bridge/analogix_dp.h
index cf17646c1310..15cb6b706e9f 100644
--- a/include/drm/bridge/analogix_dp.h
+++ b/include/drm/bridge/analogix_dp.h
@@ -27,6 +27,7 @@ static inline bool is_rockchip(enum analogix_dp_devtype type)
 struct analogix_dp_plat_data {
 	enum analogix_dp_devtype dev_type;
 	struct drm_panel *panel;
+	struct drm_bridge *bridge;
 	struct drm_encoder *encoder;
 	struct drm_connector *connector;
 	bool skip_connector;
-- 
2.34.1

