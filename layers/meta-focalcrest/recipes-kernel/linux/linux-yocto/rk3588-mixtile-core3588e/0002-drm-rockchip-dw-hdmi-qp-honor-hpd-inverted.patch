From 0b48ae7f2f8cf41c75ae249a6ae71e6692eb24df Mon Sep 17 00:00:00 2001
From: Kevin Zhuang <kevin.zhuang@focalcrest.com>
Date: Fri, 23 Oct 2026 11:10:24 +0800
Subject: [PATCH] drm/rockchip: dw-hdmi-qp: honor hpd-inverted

Some boards invert HPD. Parse the optional hpd-inverted property and
apply it to the RK3588 HPD status read.
---
Upstream-Status: Pending
 .../display/rockchip/rockchip,rk3588-dw-hdmi-qp.yaml         | 5 +++++
 drivers/gpu/drm/rockchip/dw_hdmi_qp-rockchip.c               | 5 +++++
 2 files changed, 10 insertions(+)

diff --git a/Documentation/devicetree/bindings/display/rockchip/rockchip,rk3588-dw-hdmi-qp.yaml b/Documentation/devicetree/bindings/display/rockchip/rockchip,rk3588-dw-hdmi-qp.yaml
index 96b4b08..7a88816 100644
--- a/Documentation/devicetree/bindings/display/rockchip/rockchip,rk3588-dw-hdmi-qp.yaml
+++ b/Documentation/devicetree/bindings/display/rockchip/rockchip,rk3588-dw-hdmi-qp.yaml
@@ -73,6 +73,11 @@ properties:
     maxItems: 1
     description: The HDMI/eDP PHY
 
+  hpd-inverted:
+    type: boolean
+    description:
+      On RK3588, indicates that the board inverts the HPD signal.
+
   ports:
     $ref: /schemas/graph.yaml#/properties/ports
 
diff --git a/drivers/gpu/drm/rockchip/dw_hdmi_qp-rockchip.c b/drivers/gpu/drm/rockchip/dw_hdmi_qp-rockchip.c
index 409f1a1..3d312cb 100644
--- a/drivers/gpu/drm/rockchip/dw_hdmi_qp-rockchip.c
+++ b/drivers/gpu/drm/rockchip/dw_hdmi_qp-rockchip.c
@@ -12,6 +12,7 @@
 #include <linux/hw_bitfield.h>
 #include <linux/mfd/syscon.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/phy/phy.h>
 #include <linux/regmap.h>
@@ -94,6 +95,7 @@ struct rockchip_hdmi_qp {
 	struct phy *phy;
 	struct gpio_desc *enable_gpio;
 	struct delayed_work hpd_work;
+	bool hpd_inverted;
 	int port_id;
 	const struct rockchip_hdmi_qp_ctrl_ops *ctrl_ops;
 };
@@ -175,6 +177,8 @@ dw_hdmi_qp_rk3588_read_hpd(struct dw_hdmi_qp *dw_hdmi, void *data)
 	u32 val;
 
 	regmap_read(hdmi->regmap, RK3588_GRF_SOC_STATUS1, &val);
+	if (hdmi->hpd_inverted)
+		val ^= hdmi->port_id ? RK3588_HDMI1_LEVEL_INT : RK3588_HDMI0_LEVEL_INT;
 	val &= hdmi->port_id ? RK3588_HDMI1_LEVEL_INT : RK3588_HDMI0_LEVEL_INT;
 
 	return val ? connector_status_connected : connector_status_disconnected;
@@ -458,6 +462,7 @@ static int dw_hdmi_qp_rockchip_bind(struct device *dev, struct device *master,
 	hdmi->ctrl_ops = cfg->ctrl_ops;
 	hdmi->dev = &pdev->dev;
 	hdmi->port_id = -ENODEV;
+	hdmi->hpd_inverted = of_property_read_bool(dev->of_node, "hpd-inverted");
 
 	/* Identify port ID by matching base IO address */
 	for (i = 0; i < cfg->num_ports; i++) {
-- 
